{erl_opts, [debug_info]}.

%% `rebar3 escriptize` builds a single executable: _build/default/bin/alku
{escript_main_app, alku}.
{escript_name, alku}.
%% -noinput: the Erlang VM never reads stdin, so `alku run` can hand the
%% terminal to the compiled program.
{escript_emu_args, "%%! -escript main alku -noinput\n"}.
%% Bundle the C runtime and standard library into the escript (rebar3 only adds ebin by default).
{escript_incl_extra, [{"alku/priv/runtime/*", "_build/default/lib/"},
                      {"alku/priv/stdlib/*", "_build/default/lib/"}]}.

%% `rebar3 check` runs the tests and the type checker.
{alias, [{check, [eunit, dialyzer]}]}.
